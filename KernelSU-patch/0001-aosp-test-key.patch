From 7190079f85cd661477bd7149720f088044ca4d1b Mon Sep 17 00:00:00 2001
From: soragoto <soragoto@soragoto.io>
Date: Mon, 7 Sep 2026 17:09:53 +0800
Subject: [PATCH] aosp test key

---
 kernel/manager/apk_sign.c |  11 +++++++++--
 manager/.gitignore        |   1 -
 manager/gradle.properties |   6 ++++++
 manager/key.jks           | Bin 0 -> 2547 bytes
 4 files changed, 15 insertions(+), 3 deletions(-)
 create mode 100644 manager/key.jks

diff --git a/kernel/manager/apk_sign.c b/kernel/manager/apk_sign.c
index f0e1673f..a512f6a7 100644
--- a/kernel/manager/apk_sign.c
+++ b/kernel/manager/apk_sign.c
@@ -92,18 +92,25 @@ static bool check_block(struct file *fp, u32 *size4, loff_t *pos, u32 *offset, u
     if (*size4 == expected_size) {
         *offset += *size4;
 
-#define CERT_MAX_LENGTH 1024
-        char cert[CERT_MAX_LENGTH];
+#define CERT_MAX_LENGTH 4096
+        char *cert;
         if (*size4 > CERT_MAX_LENGTH) {
             pr_info("cert length overlimit\n");
             return false;
         }
+        cert = kmalloc(*size4, GFP_KERNEL);
+        if (!cert) {
+            pr_info("cert alloc failed\n");
+            return false;
+        }
         kernel_read(fp, cert, *size4, pos);
         unsigned char digest[SHA256_DIGEST_SIZE];
         if (IS_ERR(ksu_sha256(cert, *size4, digest))) {
             pr_info("sha256 error\n");
+            kfree(cert);
             return false;
         }
+        kfree(cert);
 
         char hash_str[SHA256_DIGEST_SIZE * 2 + 1];
         hash_str[SHA256_DIGEST_SIZE * 2] = '\0';
diff --git a/manager/.gitignore b/manager/.gitignore
index a595ddf7..16a10c11 100644
--- a/manager/.gitignore
+++ b/manager/.gitignore
@@ -7,4 +7,3 @@ build
 captures
 .cxx
 local.properties
-key.jks
diff --git a/manager/gradle.properties b/manager/gradle.properties
index 2180ea37..91f0ef14 100644
--- a/manager/gradle.properties
+++ b/manager/gradle.properties
@@ -7,3 +7,9 @@ org.gradle.parallel=true
 org.gradle.vfs.watch=true
 android.r8.maxWorkers=4
 android.native.buildOutput=verbose
+
+# Reproducible local AOSP test signing (manager/key.jks is ignored by git).
+KEYSTORE_FILE=key.jks
+KEYSTORE_PASSWORD=android
+KEY_ALIAS=testkey
+KEY_PASSWORD=android
diff --git a/manager/key.jks b/manager/key.jks
new file mode 100644
index 0000000000000000000000000000000000000000..80d628e227184e00b071bc5da9fc97a783c838cf
GIT binary patch
